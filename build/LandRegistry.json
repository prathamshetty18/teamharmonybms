      "anonymous": false
    },
    {
      "type": "event",
      "name": "ClaimDisputed",
      "inputs": [
        { "name": "claimId", "type": "uint256", "indexed": true },
        { "name": "reporter", "type": "address", "indexed": true }
      ],
      "anonymous": false
    },
    {
      "type": "event",
      "name": "DisputeResolved",
      "inputs": [
        { "name": "claimId", "type": "uint256", "indexed": true },
        { "name": "newStatus", "type": "uint8", "indexed": false },
        { "name": "round", "type": "uint256", "indexed": false }
