{
  "contractName": "LandRegistry",
  "abi": [
    {
      "type": "function",
      "name": "totalClaims",
      "inputs": [],
      "outputs": [
        { "name": "", "type": "uint256" }
      ],
      "stateMutability": "view"
    },
    {
      "type": "function",
      "name": "createClaim",
      "inputs": [
        { "name": "claimant", "type": "address" },
        { "name": "ownerHash", "type": "bytes32" },
        { "name": "evidenceHash", "type": "bytes32" },
        { "name": "latE6", "type": "int32" },
        { "name": "lonE6", "type": "int32" }
      ],
      "outputs": [
        { "name": "claimId", "type": "uint256" }
      ],
      "stateMutability": "nonpayable"
    },
    {
      "type": "function",
      "name": "attest",
      "inputs": [
        { "name": "claimId", "type": "uint256" }
      ],
      "outputs": [],
      "stateMutability": "nonpayable"
    },
    {
      "type": "function",
      "name": "dispute",
      "inputs": [
        { "name": "claimId", "type": "uint256" }
      ],
      "outputs": [],
      "stateMutability": "nonpayable"
    },
    {
      "type": "function",
      "name": "resolveDispute",
      "inputs": [
        { "name": "claimId", "type": "uint256" },
        { "name": "restore", "type": "bool" }
      ],
      "outputs": [],
      "stateMutability": "nonpayable"
    },
    {
      "type": "function",
      "name": "setRole",
      "inputs": [
        { "name": "user", "type": "address" },
        { "name": "role", "type": "uint8" }
      ],
      "outputs": [],
      "stateMutability": "nonpayable"
    },
    {
      "type": "function",
      "name": "getClaim",
      "inputs": [
        { "name": "claimId", "type": "uint256" }
