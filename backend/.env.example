PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/harmonybms
DB_NAME=harmonybms
RPC_URL=https://testnetrpc.mstblockchain.com

# Database Configuration (PostgreSQL / Auth)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bhoomisetu_auth

# JWT Configuration
JWT_SECRET_KEY=change_this_to_a_super_secret_high_entropy_key_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="BhoomiSetu Auth Service"
